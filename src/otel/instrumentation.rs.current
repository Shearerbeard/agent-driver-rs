//! OpenTelemetry instrumentation helpers
//!
//! Provides RAII guards for automatic span lifecycle management following
//! the project's coding principles: finite types, explicit resource management,
//! and proper error handling.

#[cfg(feature = "phoenix")]
use crate::otel::types::{
    AgentLoopAttributes, AgentStopReason, CompletionAttributes, CompletionStatus, LlmFinishReason,
    ProviderKind, SpanKind, SpanName,
};
#[cfg(feature = "phoenix")]
use crate::Session;
#[cfg(feature = "phoenix")]
use opentelemetry::trace::{Span as SpanTrait, Status, Tracer as TracerTrait};
#[cfg(feature = "phoenix")]
use opentelemetry::Context;
#[cfg(feature = "phoenix")]
use opentelemetry::Value as AttributeValue;
#[cfg(feature = "phoenix")]
use std::sync::Arc;

#[cfg(feature = "phoenix")]
/// Completion span RAII guard
///
/// Automatically creates and closes a span around an LLM completion operation.
/// Implements `Drop` to ensure the span is always closed, even if an error occurs.
pub struct CompletionSpan {
    span: Option<SpanTrait>,
    attributes: CompletionAttributes,
}

impl CompletionSpan {
    /// Create a new completion span
    pub fn new(
        tracer: &TracerTrait,
        name: &str,
        attributes: CompletionAttributes,
    ) -> Result<Self, String> {
        let span_kind = SpanKind::Client.to_otlp_span_kind();

        let span = tracer
            .span_builder(name)
            .with_span_kind(span_kind)
            .with_attributes(create_completion_attributes(&attributes))
            .start(&tracer);

        Ok(Self {
            span: Some(span),
            attributes,
        })
    }

    /// Mark completion as successful
    pub fn mark_success(&mut self) {
        if let Some(span) = self.span.as_mut() {
            let status = CompletionStatus::Success;
            let status_code = match status {
                CompletionStatus::Success => Status::Ok,
                CompletionStatus::Partial => Status::Ok,
                CompletionStatus::Error { .. } => Status::Error,
            };

            span.set_status(status_code);
            span.set_attribute(
                "llm.finish_reason",
                LlmFinishReason::Stop.as_inference_reason(),
            );
        }
    }

    /// Mark completion as failed
    pub fn mark_failure(&mut self, message: impl Into<String>) {
        if let Some(span) = self.span.as_mut() {
            span.set_status(Status::Error);
            span.set_attribute("error.message", message.into());
        }
    }
}

#[cfg(feature = "phoenix")]
impl CompletionSpan {
    /// Create a new completion span
    pub fn new(
        tracer: &opentelemetry::trace::Tracer,
        name: &str,
        attributes: CompletionAttributes,
    ) -> Result<Self, String> {
        let span_kind = SpanKind::Client.to_otlp_span_kind();

        let span = tracer
            .span_builder(name)
            .with_span_kind(span_kind)
            .with_attributes(create_completion_attributes(&attributes))
            .start(&tracer);

        Ok(Self {
            span: Some(span),
            attributes,
        })
    }

    /// Mark completion as successful
    pub fn mark_success(&mut self) {
        if let Some(span) = self.span.as_mut() {
            let status = CompletionStatus::Success;
            let status_code = match status {
                CompletionStatus::Success => Status::Ok,
                CompletionStatus::Partial => Status::Ok,
                CompletionStatus::Error { .. } => Status::Error,
            };

            span.set_status(status_code);
            span.set_attribute(
                "llm.finish_reason",
                LlmFinishReason::Stop.as_inference_reason(),
            );
        }
    }

    /// Mark completion as failed
    pub fn mark_failure(&mut self, message: impl Into<String>) {
        if let Some(span) = self.span.as_mut() {
            span.set_status(Status::Error);
            span.set_attribute("error.message", message.into());
        }
    }
}

#[cfg(feature = "phoenix")]
impl Drop for CompletionSpan {
    fn drop(&mut self) {
        if let Some(span) = self.span.take() {
            let _ = span.end();
        }
    }
}

#[cfg(feature = "phoenix")]
/// Agent loop span RAII guard
///
/// Wraps the entire agent loop execution with a root span and creates
/// child spans for iterations and tool executions.
pub struct AgentLoopSpan {
    span: Option<SpanTrait>,
    tracer: Arc<TracerTrait>,
    iteration: Option<u32>,
}

impl AgentLoopSpan {
    /// Create a new agent loop span
    pub fn new(tracer: &TracerTrait, name: &str, agent_name: &str) -> Result<Self, String> {
        let span = tracer
            .span_builder(name)
            .with_span_kind(SpanKind::Server.to_otlp_span_kind())
            .with_attribute("agent.name", agent_name)
            .start(&tracer);

        Ok(Self {
            span: Some(span),
            tracer: tracer.clone(),
            iteration: Some(0),
        })
    }

    /// Record the outcome of the agent loop
    pub fn record_outcome(&mut self, stop_reason: AgentStopReason, iterations: u32) {
        if let Some(span) = self.span.as_mut() {
            let reason_str = match stop_reason {
                AgentStopReason::Normal => "normal",
                AgentStopReason::ToolExecutionCompleted => "tool_execution_completed",
                AgentStopReason::MaxToolDepthReached => "max_tool_depth_reached",
                AgentStopReason::Cancelled => "cancelled",
                AgentStopReason::ToolError { .. } => "tool_error",
            };

            span.set_attribute("agent.stop_reason", reason_str);
            span.set_attribute("agent.iterations", iterations);

            // Mark as successful unless cancelled
            if !matches!(stop_reason, AgentStopReason::Cancelled) {
                span.set_status(Status::Ok);
            }
        }
    }

    /// Create a child span for tool execution
    pub fn create_tool_span(&self, tool_name: &str) -> Result<ToolSpan, String> {
        let span = self
            .tracer
            .span_builder(format!("tool_execution.{}", tool_name))
            .with_span_kind(SpanKind::Internal.to_otlp_span_kind())
            .with_attribute("tool.name", tool_name)
            .start(&self.tracer);

        Ok(ToolSpan {
            span: Some(span),
            tool_name: tool_name.to_string(),
        })
    }

    /// Create a child span for iteration
    pub fn create_iteration_span(&self, iteration: u32) -> Option<IterationSpan> {
        let span = self
            .tracer
            .span_builder(format!("iteration.{}", iteration))
            .with_span_kind(SpanKind::Internal.to_otlp_span_kind())
            .with_attribute("agent.iteration", iteration)
            .start(&self.tracer);

        Some(IterationSpan {
            span: Some(span),
            iteration,
        })
    }
}

#[cfg(feature = "phoenix")]
impl AgentLoopSpan {
    /// Create a new agent loop span
    pub fn new(
        tracer: &opentelemetry::trace::Tracer,
        name: &str,
        agent_name: &str,
