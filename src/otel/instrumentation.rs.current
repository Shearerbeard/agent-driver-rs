impl Drop for AgentLoopSpan {
    fn drop(&mut self) {
        if let Some(span) = self.span.take() {
            let _ = span.end();
        }
    }
}

#[cfg(feature = "phoenix")]
/// Tool execution span RAII guard
pub struct ToolSpan {
    span: Option<SpanTrait>,
    tool_name: String,
}

impl ToolSpan {
    /// Create a new tool span
    pub fn new(tracer: &TracerTrait, name: &str) -> Result<Self, String> {
        let span = tracer
            .span_builder(name)
            .with_span_kind(SpanKind::Internal.to_otlp_span_kind())
            .with_attribute("tool.name", name)
            .start(&tracer);

        Ok(Self {
            span: Some(span),
            tool_name: name.to_string(),
        })
    }

    /// Mark tool execution as successful
    pub fn mark_success(&mut self) {
        if let Some(span) = self.span.as_mut() {
            span.set_status(Status::Ok);
        }
    }

    /// Mark tool execution as failed
    pub fn mark_failure(&mut self, message: impl Into<String>) {
        if let Some(span) = self.span.as_mut() {
            span.set_status(Status::Error);
            span.set_attribute("error.message", message.into());
        }
    }
}

#[cfg(feature = "phoenix")]
