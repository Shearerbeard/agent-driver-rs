//! OpenTelemetry instrumentation helpers
//!
//! Provides RAII guards for automatic span lifecycle management.

#[cfg(feature = "phoenix")]
use crate::otel::types::{
    AgentLoopAttributes, AgentStopReason, CompletionAttributes, ToolExecutionAttributes,
};

#[cfg(feature = "phoenix")]
use opentelemetry::trace::{Span, Tracer};
use opentelemetry::{Key, Value};

#[cfg(feature = "phoenix")]
pub struct CompletionSpan {
    span: Option<opentelemetry_sdk::trace::Span>,
    attributes: CompletionAttributes,
}

#[cfg(feature = "phoenix")]
impl CompletionSpan {
    pub fn new(
        tracer: &opentelemetry_sdk::trace::Tracer,
        name: &str,
        attributes: CompletionAttributes,
    ) -> Result<Self, String> {
        let span = tracer.start(name);
        Ok(Self {
            span: Some(span),
            attributes,
        })
    }

    pub fn mark_success(&mut self) {
        if let Some(span) = &mut self.span {
            // Mark span as success
            span.set_status(opentelemetry::trace::Status::Ok);
        }
    }

    pub fn mark_failure(&mut self, message: impl Into<String>) {
        if let Some(span) = &mut self.span {
            // Mark span as failed with error message
            span.set_status(opentelemetry::trace::Status::error(message.into()));
        }
    }
}

#[cfg(feature = "phoenix")]
pub struct AgentLoopSpan {
    span: Option<opentelemetry_sdk::trace::Span>,
    agent_name: String,
}

#[cfg(feature = "phoenix")]
impl AgentLoopSpan {
    pub fn new(
        tracer: &opentelemetry_sdk::trace::Tracer,
        name: &str,
        agent_name: &str,
    ) -> Result<Self, String> {
        let span = tracer.start(name);
        Ok(Self {
            span: Some(span),
            agent_name: agent_name.to_string(),
        })
    }

    pub fn record_outcome(&mut self, stop_reason: AgentStopReason, iterations: u32) {
        if let Some(span) = &mut self.span {
            // Set attributes for the agent loop outcome
            span.set_attribute(Key::from("agent.stop_reason").string(stop_reason.to_string()));
            span.set_attribute(Key::from("agent.iterations").u64(iterations));
        }
    }

    pub fn create_tool_span(&self, _tool_name: &str) -> Option<ToolSpan> {
        // For now, return None to match expected API
        // In a full implementation, this would create a new ToolSpan
        None
    }

    pub fn create_iteration_span(&self, _iteration: u32) -> Option<IterationSpan> {
        // For now, return None to match expected API
        // In a full implementation, this would create a new IterationSpan
        None
    }
}

#[cfg(feature = "phoenix")]
pub struct ToolSpan {
    span: Option<opentelemetry_sdk::trace::Span>,
    tool_name: String,
}

#[cfg(feature = "phoenix")]
impl ToolSpan {
    pub fn new(tracer: &opentelemetry_sdk::trace::Tracer, name: &str) -> Result<Self, String> {
        let span = tracer.start(name);
        Ok(Self {
            span: Some(span),
            tool_name: name.to_string(),
        })
    }

    pub fn mark_success(&mut self) {
        if let Some(span) = &mut self.span {
            span.set_status(opentelemetry::trace::Status::Ok);
        }
    }

    pub fn mark_failure(&mut self, message: impl Into<String>) {
        if let Some(span) = &mut self.span {
            span.set_status(opentelemetry::trace::Status::error(message.into()));
        }
    }
}

#[cfg(feature = "phoenix")]
pub struct IterationSpan {
    span: Option<opentelemetry_sdk::trace::Span>,
    iteration: u32,
}

#[cfg(feature = "phoenix")]
impl IterationSpan {
    pub fn new(tracer: &opentelemetry_sdk::trace::Tracer, iteration: u32) -> Result<Self, String> {
        let span = tracer.start(format!("iteration.{}", iteration));
        Ok(Self {
            span: Some(span),
            iteration,
        })
    }
}

#[cfg(feature = "phoenix")]
pub struct SessionOperationSpan {
    span: Option<opentelemetry_sdk::trace::Span>,
    operation: String,
}

#[cfg(feature = "phoenix")]
impl SessionOperationSpan {
    pub fn new(tracer: &opentelemetry_sdk::trace::Tracer, operation: &str) -> Result<Self, String> {
        let span = tracer.start(operation);
        Ok(Self {
            span: Some(span),
            operation: operation.to_string(),
        })
    }

    pub fn inner(&self) -> Option<&()> {
        None
    }
}

#[cfg(feature = "phoenix")]
pub fn create_completion_attributes(
    attributes: &CompletionAttributes,
) -> Vec<(String, opentelemetry::Value)> {
    vec![
        (
            "llm.model".to_string(),
            attributes.model.as_str().to_string().into(),
        ),
        (
            "llm.provider".to_string(),
            attributes.provider.as_str().to_string().into(),
        ),
    ]
}

#[cfg(feature = "phoenix")]
pub fn create_agent_loop_attributes(
    attributes: &AgentLoopAttributes,
) -> Vec<(String, opentelemetry::Value)> {
    vec![(
        "agent.name".to_string(),
        attributes.name.as_str().to_string().into(),
    )]
}

#[cfg(feature = "phoenix")]
pub fn create_tool_attributes(
    attributes: &ToolExecutionAttributes,
) -> Vec<(String, opentelemetry::Value)> {
    vec![(
        "tool.name".to_string(),
        attributes.tool_name.as_str().to_string().into(),
    )]
}

#[cfg(all(test, feature = "phoenix"))]
mod tests {
    use super::*;

    #[test]
    fn test_completion_span_creation() {
        let tracer = opentelemetry_sdk::trace::TracerProvider::default().tracer("test");
        let attributes = CompletionAttributes {
            model: "test-model".to_string(),
            provider: "test-provider".to_string(),
            completion_status: CompletionStatus::Success,
            prompt_tokens: Some(10),
            completion_tokens: Some(20),
            total_tokens: Some(30),
            temperature: Some(0.7),
        };

        let span = CompletionSpan::new(&tracer, "llm.completion", attributes).unwrap();
        assert!(span.span.is_some());
    }

    #[test]
    fn test_completion_span_mark_success() {
        let tracer = opentelemetry_sdk::trace::TracerProvider::default().tracer("test");
        let mut span = CompletionSpan::new(
            &tracer,
            "llm.completion",
            CompletionAttributes {
                model: "test-model".to_string(),
                provider: "test-provider".to_string(),
                completion_status: CompletionStatus::Success,
                prompt_tokens: None,
                completion_tokens: None,
                total_tokens: None,
                temperature: None,
            },
        )
        .unwrap();

        span.mark_success();
        // Verify span was marked as successful
    }

    #[test]
    fn test_completion_span_mark_failure() {
        let tracer = opentelemetry_sdk::trace::TracerProvider::default().tracer("test");
        let mut span = CompletionSpan::new(
            &tracer,
            "llm.completion",
            CompletionAttributes {
                model: "test-model".to_string(),
                provider: "test-provider".to_string(),
                completion_status: CompletionStatus::Success,
                prompt_tokens: None,
                completion_tokens: None,
                total_tokens: None,
                temperature: None,
            },
        )
        .unwrap();

        span.mark_failure("test error");
        // Verify span was marked as failed
    }

    #[test]
    fn test_agent_loop_span_creation() {
        let tracer = opentelemetry_sdk::trace::TracerProvider::default().tracer("test");
        let span = AgentLoopSpan::new(&tracer, "agent.loop", "test-agent").unwrap();
        assert!(span.span.is_some());
    }

    #[test]
    fn test_agent_loop_span_record_outcome() {
        let tracer = opentelemetry_sdk::trace::TracerProvider::default().tracer("test");
        let mut span = AgentLoopSpan::new(&tracer, "agent.loop", "test-agent").unwrap();

        span.record_outcome(AgentStopReason::Normal, 5);
        // Verify attributes were set
    }

    #[test]
    fn test_tool_span_creation() {
        let tracer = opentelemetry_sdk::trace::TracerProvider::default().tracer("test");
        let span = ToolSpan::new(&tracer, "tool.test").unwrap();
        assert!(span.span.is_some());
    }

    #[test]
    fn test_tool_span_mark_success() {
        let tracer = opentelemetry_sdk::trace::TracerProvider::default().tracer("test");
        let mut span = ToolSpan::new(&tracer, "tool.test").unwrap();

        span.mark_success();
        // Verify span was marked as successful
    }

    #[test]
    fn test_tool_span_mark_failure() {
        let tracer = opentelemetry_sdk::trace::TracerProvider::default().tracer("test");
        let mut span = ToolSpan::new(&tracer, "tool.test").unwrap();

        span.mark_failure("test error");
        // Verify span was marked as failed
    }
}
