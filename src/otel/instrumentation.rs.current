#[cfg(feature = "phoenix")]
// ── Helper Functions ───────────────────────────────────────────────────────

/// Create completion span attributes from a request and response
pub fn create_completion_attributes(
    attributes: &CompletionAttributes,
) -> Vec<(&str, AttributeValue)> {
    let mut attrs = vec![
        ("llm.model", attributes.model.as_str().into()),
        ("llm.provider", attributes.provider.as_str().into()),
        (
            "llm.completion_status",
            format!("{:?}", attributes.completion_status)
                .as_str()
                .into(),
        ),
    ];

    if let Some(tokens) = attributes.prompt_tokens {
        attrs.push(("llm.prompt_tokens", tokens.into()));
    }

    if let Some(tokens) = attributes.completion_tokens {
        attrs.push(("llm.completion_tokens", tokens.into()));
    }

    if let Some(tokens) = attributes.total_tokens {
        attrs.push(("llm.total_tokens", tokens.into()));
    }

    if let Some(temp) = attributes.temperature {
        attrs.push(("llm.temperature", temp.into()));
    }

    attrs
}

/// Create agent loop span attributes
pub fn create_agent_loop_attributes(
    attributes: &AgentLoopAttributes,
) -> Vec<(&str, AttributeValue)> {
    let mut attrs = vec![("agent.name", attributes.name.as_str().into())];

    if let Some(iteration) = attributes.iteration {
        attrs.push(("agent.iteration", iteration.into()));
    }

    if let Some(reason) = attributes.stop_reason.as_ref() {
        let reason_str = match reason {
            AgentStopReason::Normal => "normal",
            AgentStopReason::ToolExecutionCompleted => "tool_execution_completed",
            AgentStopReason::MaxToolDepthReached => "max_tool_depth_reached",
            AgentStopReason::Cancelled => "cancelled",
            AgentStopReason::ToolError { .. } => "tool_error",
        };
        attrs.push(("agent.stop_reason", reason_str.into()));
    }

    if let Some(count) = attributes.tool_count {
        attrs.push(("agent.tool_count", count.into()));
    }

    if let Some(text) = &attributes.response_text {
        attrs.push(("agent.response", text.as_str().into()));
    }

    attrs
}

/// Create tool execution span attributes
pub fn create_tool_attributes(attributes: &ToolExecutionAttributes) -> Vec<(&str, AttributeValue)> {
    let mut attrs = vec![("tool.name", attributes.tool_name.as_str().into())];

    if let Some(tokens) = attributes.input_tokens {
        attrs.push(("tool.input_tokens", tokens.into()));
    }

    if let Some(tokens) = attributes.output_tokens {
        attrs.push(("tool.output_tokens", tokens.into()));
    }

    attrs.push(("tool.success", attributes.success.into()));

    if let Some(msg) = &attributes.error_message {
        attrs.push(("error.message", msg.as_str().into()));
    }

    attrs
}

#[cfg(feature = "phoenix")]
#[cfg(test)]
mod tests {
    use super::*;
    use opentelemetry::sdk::trace::TracerProvider;

    #[test]
    fn test_completion_span_creation() {
        let provider = TracerProvider::default();
        let tracer = provider.tracer("test");

        let attrs = CompletionAttributes {
            model: "test-model".to_string(),
            provider: "openai".to_string(),
            completion_status: CompletionStatus::Success,
            prompt_tokens: Some(10),
            completion_tokens: Some(50),
            total_tokens: Some(60),
            temperature: Some(0.7),
        };

        let span = CompletionSpan::new(&tracer, "test", attrs).unwrap();
        span.mark_success();
    }

    #[test]
    fn test_agent_loop_span_creation() {
        let provider = TracerProvider::default();
        let tracer = provider.tracer("test");

        let span = AgentLoopSpan::new(&tracer, "test-loop", "test-agent").unwrap();
        span.record_outcome(AgentStopReason::Normal, 1);
    }

    #[test]
    fn test_tool_span_creation() {
        let provider = TracerProvider::default();
        let tracer = provider.tracer("test");

        let span = ToolSpan::new(&tracer, "test_tool").unwrap();
        span.mark_success();
    }

    #[test]
    fn test_session_span_creation() {
        let provider = TracerProvider::default();
        let tracer = provider.tracer("test");

        let span = SessionOperationSpan::new(&tracer, "test_operation").unwrap();
    }
}
