# agent-driver-rs configuration
# Copy this file to .env and fill in your values

# Provider selection (one of: anthropic, openai, bedrock, openrouter, ollama)
PROVIDER=anthropic

# =============================================================================
# Anthropic Configuration
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096
# ANTHROPIC_TEMPERATURE=1.0
# ANTHROPIC_THINKING_BUDGET=8192

# =============================================================================
# OpenAI Configuration
# GPT-5.x uses reasoning, not temperature
# =============================================================================
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_MAX_TOKENS=4096
# OPENAI_TEMPERATURE=1.0
# OPENAI_REASONING_EFFORT=medium  # none, minimal, low, medium, high, xhigh

# =============================================================================
# AWS Bedrock Configuration
# Uses AWS credentials from environment/profile
# NOTE: Newer models (Claude 4.5) require an inference profile!
# =============================================================================
# AWS_REGION=us-east-1
# BEDROCK_MODEL=claude-sonnet-4.5  # claude-sonnet-4, claude-sonnet-4.5, claude-opus-4.5
# BEDROCK_MAX_TOKENS=4096
# BEDROCK_TEMPERATURE=1.0
# BEDROCK_INFERENCE_PROFILE=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# =============================================================================
# OpenRouter Configuration
# =============================================================================
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-4
# OPENROUTER_MAX_TOKENS=4096
# OPENROUTER_TEMPERATURE=1.0

# =============================================================================
# Ollama Configuration
# num_ctx is critical for context window size
# =============================================================================
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_NUM_CTX=8192
# OLLAMA_MAX_TOKENS=4096
# OLLAMA_TEMPERATURE=0.7
# OLLAMA_KEEP_ALIVE=indefinite  # indefinite, unload, or minutes (e.g., 30)
